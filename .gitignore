# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets, JAMAIS commit (sauf .env.example)
.env
.env.local
.env.*.local
!.env.example

# stockage local (fichiers uploadés en dev)
.storage/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.git/.git-credentials-store

# desktop electron wrapper — build artifacts ne sont pas commit
# (générés par GitHub Actions et uploadés en assets de release)
desktop/node_modules/
desktop/dist/
desktop/package-lock.json

# mobile capacitor wrapper — idem
mobile/node_modules/
mobile/android/
mobile/ios/
mobile/package-lock.json

# État de l'outillage d'agent — jamais versionné (identifiants de session,
# vidages d'erreurs). Deux copies s'étaient glissées dans app/.
.omc/
