# ============================================================
# mycloud — variables d'environnement
# Copie ce fichier en .env.local et remplis les valeurs
# ============================================================

# --- Base de données Postgres ---
# Crée une base gratuite sur https://neon.tech (recommandé) ou Supabase
DATABASE_URL="postgresql://user:password@host:5432/mycloud?sslmode=require"

# --- NextAuth ---
# Génère un secret avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (optionnel pour démarrer)
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend pour magic links)
# https://resend.com — gratuit jusqu'à 3000 emails/mois
AUTH_RESEND_KEY=""
EMAIL_FROM="MyCloud <noreply@ton-domaine.com>"

# --- Stockage Cloudflare R2 (par défaut) ---
# https://dash.cloudflare.com → R2
# Crée un bucket et une API token avec accès R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="mycloud"
R2_ENDPOINT=""  # https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=""  # https://pub-xxx.r2.dev ou ton CDN

# --- Paiements ---
# Stripe (cartes EUR + USD)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Coinbase Commerce (crypto) - optionnel pour V1
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""

# --- WhatsApp Business (Phase 4) ---
# https://business.whatsapp.com
WHATSAPP_BUSINESS_NUMBER=""  # +33612345678 (visible client)
WHATSAPP_CLOUD_API_TOKEN=""

# --- App ---
NEXT_PUBLIC_APP_NAME="mycloud"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_BOOTSTRAP_EMAIL=""  # ton email — sera admin au premier login
