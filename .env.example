# ============================================================
# mycloud — variables d'environnement
# Copie ce fichier en .env.local et remplis les valeurs
# ============================================================

# --- Base de données Postgres ---
# Crée une base gratuite sur https://neon.tech (recommandé) ou Supabase
DATABASE_URL="postgresql://user:password@host:5432/mycloud?sslmode=require"

# --- NextAuth ---
# Génère un secret avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (optionnel pour démarrer)
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend pour magic links)
# https://resend.com — gratuit jusqu'à 3000 emails/mois
AUTH_RESEND_KEY=""
EMAIL_FROM="MyTitanCloud <noreply@mytitancloud.com>"

# --- Stockage Cloudflare R2 (par défaut) ---
# https://dash.cloudflare.com → R2
# Crée un bucket et une API token avec accès R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="mycloud"
R2_ENDPOINT=""  # https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=""  # https://pub-xxx.r2.dev ou ton CDN

# --- Paiements ---
# Stripe (cartes EUR + USD)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Coinbase Commerce (crypto) - optionnel pour V1
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""

# --- WhatsApp Business Cloud API ---
# https://developers.facebook.com/apps → Crée une app WhatsApp Business
# Récupère le Phone Number ID + access token permanent (System User)
WHATSAPP_BUSINESS_NUMBER=""        # +33612345678 (affiché aux clients pour les contacter)
WHATSAPP_CLOUD_API_TOKEN=""        # EAAGm... (Bearer token Meta)
WHATSAPP_PHONE_NUMBER_ID=""        # 123456789012345 (Phone Number ID Meta)

# --- App ---
NEXT_PUBLIC_APP_NAME="mytitancloud"
NEXT_PUBLIC_APP_URL="https://mytitancloud.com"
ADMIN_BOOTSTRAP_EMAIL=""  # ton email — sera admin au premier login

# --- Limitation de débit : Upstash Redis (fortement recommandé) ---
# SANS ces variables, les compteurs sont gardés en mémoire de chaque
# instance serverless. Comme Vercel en lance plusieurs, un attaquant dont
# les requêtes tombent sur des instances différentes n'est jamais bloqué :
# la protection contre la force brute est alors inopérante en production.
# console.upstash.com → ta base Redis → onglet "REST API"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Remontée d'erreurs : Sentry (fortement recommandé) ---
# Sans DSN, le SDK est totalement inactif et aucune erreur de production
# n'est visible côté équipe.
# sentry.io → projet Next.js → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""

# Facultatif : affiche la ligne de code exacte au lieu du JS minifié.
# Le build réussit sans ces variables.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
